# ==========================================================
# CATATAN KEUANGAN - WEB ACCESS PROTECTION
# Letakkan file ini di ROOT aplikasi, sejajar dengan index.php
# ==========================================================

# Jangan pernah tampilkan isi folder.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------
    # 1. Blok file/folder tersembunyi (.git, .env, .user.ini, dst.)
    #    .well-known tetap diizinkan untuk SSL/ACME.
    # ------------------------------------------------------
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]

    # ------------------------------------------------------
    # 2. Folder yang sama sekali tidak boleh diakses dari web.
    #    PHP aplikasi tetap dapat membacanya melalui filesystem.
    # ------------------------------------------------------
    RewriteRule ^(?:data|catatan-keuangan-android-webview-android)(?:/|$) - [F,L,NC]

    # ------------------------------------------------------
    # 3. Semua JSON diblok kecuali manifest.json yang diperlukan PWA.
    # ------------------------------------------------------
    RewriteRule ^(?!manifest\.json$).*\.json$ - [F,L,NC]

    # ------------------------------------------------------
    # 4. Blok file sensitif / source / backup dari browser.
    # ------------------------------------------------------
    RewriteRule \.(?:env|ini|log|sql|sqlite|db|bak|backup|old|orig|dist|lock|md|txt|zip|rar|7z|tar|gz|sh|command|pem|key|crt|p12|pfx|keystore|jks)$ - [F,L,NC]

    # ------------------------------------------------------
    # 5. Blok SEMUA file PHP di ROOT kecuali halaman yang memang publik.
    #
    #    YANG DIIJINKAN:
    #    - index.php
    #    - privacy-policy.php
    #    - delete-account.php
    #    - android-download.php
    #
    #    File PHP di /ajax tetap dapat dipanggil aplikasi dan harus
    #    tetap memakai auth/session validation di masing-masing endpoint.
    # ------------------------------------------------------
    RewriteRule ^(?!index\.php$|privacy-policy\.php$|delete-account\.php$|android-download\.php$)[^/]+\.php$ - [F,L,NC]
</IfModule>

# Proteksi tambahan bila mod_rewrite tidak aktif.
<FilesMatch "^(?:\.env|\.gitignore|\.user\.ini|composer\.(?:json|lock)|package(?:-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ==========================================================
# BEGIN cPanel-generated php ini directives, do not edit
# ==========================================================
<IfModule php7_module>
   php_value error_log "/home/catk5343/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/catk5343/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives
