{
  "name": "charlie/catatan-keuangan-yii2",
  "description": "Catatan Keuangan - Yii2 Basic + MySQL migration",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.1",
    "yiisoft/yii2": "2.0.55",
    "vlucas/phpdotenv": "^5.6"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  }
}
