# =============================================================
# Catatan Keuangan - Public Web Root
# Hanya isi folder /web yang memang ditujukan untuk HTTP.
# =============================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Tolak TRACE dan path traversal.
RewriteCond %{REQUEST_METHOD} ^TRACE$ [NC]
RewriteRule ^ - [F,L]
RewriteCond %{THE_REQUEST} "(?:\.\./|%2e%2e|%252e%252e)" [NC]
RewriteRule ^ - [F,L]

# Hidden file tetap ditolak. .well-known dikecualikan bila dibutuhkan SSL/ACME.
RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]

# Semua endpoint kompatibilitas lama dipaksa melalui front controller Yii.
RewriteRule ^ajax/([A-Za-z0-9_]+)\.php$ index.php?r=legacy-api/bridge&name=$1 [QSA,L,NC]

# Pretty/fallback routing Yii.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
</IfModule>

# Jangan pernah layani file konfigurasi/source/backup bila terselip ke /web.
<FilesMatch "(?i)(^\.|composer\.(?:json|lock)$|^yii$|\.(?:env|ini|log|sql|bak|dist|md|lock|sh|yml|yaml)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
Header always set X-Permitted-Cross-Domain-Policies "none"
Header always set X-Download-Options "noopen"
Header always unset X-Powered-By
</IfModule>


# V64 — compression aman untuk response text.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>


# Front controller membawa data keuangan/account; jangan cache HTML/PHP oleh proxy bersama.
<IfModule mod_headers.c>
    <FilesMatch "(?i)\\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# V77 — Custom static error pages untuk document root /web.
ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 408 /errors/408.html
ErrorDocument 429 /errors/429.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/502.html
ErrorDocument 503 /errors/503.html
ErrorDocument 504 /errors/504.html
