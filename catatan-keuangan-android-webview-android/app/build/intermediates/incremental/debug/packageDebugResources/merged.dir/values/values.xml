<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#F5F7FB</color>
    <color name="primary">#175CD3</color>
    <color name="primary_dark">#0F4BB3</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Catatan Keuangan</string>
    <string name="offline_message">Aplikasi akan memakai data yang sudah tersimpan di perangkat. Hubungkan internet untuk sinkronisasi otomatis.</string>
